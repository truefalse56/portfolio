Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Защита служебных каталогов
    RewriteRule ^(config|includes|sql|templates|storage|app|vendor)(/|$) - [F,L]

    # Отдаём только реальные ФАЙЛЫ (css/js/uploads/favicon…).
    # Каталоги вроде /admin/ не пропускаем — их обрабатывает Slim.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Всё остальное — Slim front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
