{
  "name": "kilin/portfolio",
  "description": "Personal portfolio (Slim 4)",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "includes/helpers.php",
      "includes/seo.php",
      "includes/db.php",
      "includes/auth.php",
      "includes/upload.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
